  [1m[36mArticle Create (0.3ms)[0m  [1m[32mINSERT INTO "articles" ("title", "content", "slug", "status", "category", "author", "published_at", "created_at", "updated_at") VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9) RETURNING "id"[0m  [["title", "南太平洋で新種の深海生物「ルミナス・アビサリス」を発見"], ["content", "\n    <h1>南太平洋で新種の深海生物「ルミナス・アビサリス」を発見</h1>\n    <p class=\"lead\">国際海洋調査チームは、マリアナ海溝近くの水深8,200メートルで、これまでに見たことのない発光する深海生物を発見しました。</p>\n    <h2>前例のない生物学的特徴</h2>\n    <p>全長約30センチのルミナス・アビサリスは、透明なゼラチン質の体と、驚くべき発光能力を持っています。体全体が7色に輝き、その光のパターンは複雑なシーケンスで変化することが観測されました。</p>\n    <figure>\n      <img src=\"/images/luminous-abyssalis.jpg\" alt=\"ルミナス・アビサリスの発光の様子\">\n      <figcaption>深海探査機が撮影したルミナス・アビサリスの発光の様子</figcaption>\n    </figure>\n    <h2>進化の謎</h2>\n    <p>この生物のDNA分析結果には、これまで地球上で確認されていないパターンが含まれています。</p>\n    <h2>今後の研究計画</h2>\n    <p>研究チームはより詳細な解析と生理学的研究を進める予定です。</p>\n  "], ["slug", "new-deep-sea-creature-discovered"], ["status", "published"], ["category", "科学"], ["author", "鈴木海"], ["published_at", "2025-04-02 04:00:30.678670"], ["created_at", "2025-04-03 04:00:30.680700"], ["updated_at", "2025-04-03 04:00:30.680700"]]
